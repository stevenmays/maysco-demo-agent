{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "sst-env.d.ts",
    "packages/core/src/**/*.ts",
    "packages/functions/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", ".sst"]
}
